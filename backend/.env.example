# ==============================================================================
# RecoverAI API — Backend Environment Configuration Template
# Copy this file to `backend/.env` and fill in values appropriate for your environment.
# Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# SQLAlchemy PostgreSQL connection string using the psycopg3 driver prefix (+psycopg).
# Direct connection (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543) — recommended for API instances:
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Application environment: 'development', 'staging', or 'production'
APP_ENVIRONMENT=development

# One-time migration legacy password bootstrap flag (disabled by default)
LEGACY_PASSWORD_BOOTSTRAP_ENABLED=false
DEVELOPMENT_SCHEDULER_TEST_ENABLED=false

# ------------------------------------------------------------------------------
# 2. JWT & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit random string (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. RAZORPAY INTEGRATION (Test Mode)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Webhook secret configured in Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 4. CUSTOMER NOTIFICATIONS & SMTP EMAIL
# ------------------------------------------------------------------------------
# Toggle customer email notifications. When false, payment links are generated
# and audited without triggering external SMTP network calls.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-store-notifications@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_USE_TLS=true
EMAIL_FROM="RecoverAI Notifications <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 5. FRONTEND URLS & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS headers
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL used to construct customer payment link emails and password reset links
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. AI RECOVERY DECISION ENGINE
# ------------------------------------------------------------------------------
# Local Ollama or remote LLM endpoint. Ollama requires no external API keys.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 7. RECOVERY CONFIGURATION & WORKERS
# ------------------------------------------------------------------------------
# Maximum recovery attempts before an unrecovered case is automatically closed
RECOVERY_MAX_ATTEMPTS=3

# Background scheduler worker for durable delayed retries
RECOVERY_SCHEDULER_ENABLED=true
RECOVERY_SCHEDULER_POLL_SECONDS=15

# Autonomous continuous recovery agent worker
RECOVERY_AGENT_WORKER_ENABLED=true
RECOVERY_AGENT_POLL_SECONDS=10

# ------------------------------------------------------------------------------
# 8. PASSWORD RESET CONFIGURATION
# ------------------------------------------------------------------------------
# Expiry window for password reset tokens in minutes (allowed range: 5 to 60)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
