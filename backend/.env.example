# RecoverAI API — copy to .env and fill in values.
# Supabase: Project Settings → Database → Connection string.

# SQLAlchemy URL. Use the +psycopg driver prefix.
# Direct (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543) — recommended for the API:
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Local-only one-time migration credential bootstrap. Keep disabled by default.
APP_ENVIRONMENT=development
LEGACY_PASSWORD_BOOTSTRAP_ENABLED=false
DEVELOPMENT_SCHEDULER_TEST_ENABLED=false

# Next.js frontend origins (comma-separated). Used by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI recovery decision engine
# Ollama runs models locally and does not require an API key. Install Ollama and
# download the selected model before calling the analyze endpoint.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
RECOVERY_MAX_ATTEMPTS=3

# Razorpay Test Mode credentials. Keep values empty in this template.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Merchant authentication. Generate a long random secret for each environment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
